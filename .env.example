# LINE Developers コンソールで作成した Messaging API チャネルの値をコピー
# https://developers.line.biz/console/

LINE_CHANNEL_ACCESS_TOKEN=ここにチャネルアクセストークン
LINE_CHANNEL_SECRET=ここにチャネルシークレット

# Claude API (鑑定文生成用)。未設定の場合は命式のみ返却。
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=
# 鑑定モデル（既定: claude-opus-4-8）。コスト重視なら claude-sonnet-4-6 や claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-4-8

# フリーミアム動作（既定 true）：無料ユーザーには性格傾向のみ返却、完全鑑定への案内付き
# 開発・検証中に全文を見たい場合は false にする
FREEMIUM_MODE=true
